#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Support\Env;
use Dotenv\Dotenv;

require __DIR__ . '/../vendor/autoload.php';

$root = dirname(__DIR__);

if (is_file($root . '/.env')) {
    Dotenv::createImmutable($root)->safeLoad();
}

$host = Env::get('DB_HOST', '127.0.0.1');
$dsn = sprintf('pgsql:host=%s;port=%s;dbname=%s', $host, Env::get('DB_PORT', '5432'), Env::get('DB_NAME', 'kanban_urzedowy'));

try {
    $pdo = new PDO($dsn, Env::get('DB_USER'), Env::get('DB_PASSWORD'), [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION]);
} catch (PDOException $e) {
    fwrite(STDERR, "Blad polaczenia ($host): {$e->getMessage()}\n");
    fwrite(STDERR, "Z hosta uzyj: DB_HOST=127.0.0.1 php bin/migrate\n");
    exit(1);
}

$pdo->exec('CREATE TABLE IF NOT EXISTS migrations (filename TEXT PRIMARY KEY, applied_at TIMESTAMPTZ NOT NULL DEFAULT now())');
$applied = $pdo->query('SELECT filename FROM migrations')->fetchAll(PDO::FETCH_COLUMN);

$files = glob($root . '/migrations/*.sql') ?: [];
sort($files);

$ran = 0;
foreach ($files as $file) {
    $name = basename($file);

    if (in_array($name, $applied, true)) {
        continue;
    }

    $pdo->beginTransaction();
    try {
        $pdo->exec((string) file_get_contents($file));
        $pdo->prepare('INSERT INTO migrations (filename) VALUES (?)')->execute([$name]);
        $pdo->commit();
        echo "OK   $name\n";
        $ran++;
    } catch (PDOException $e) {
        $pdo->rollBack();
        fwrite(STDERR, "FAIL $name: {$e->getMessage()}\n");
        exit(1);
    }
}

echo $ran === 0 ? "Brak nowych migracji.\n" : "Zastosowano migracji: $ran\n";
